{
  "name": "bassline",
  "version": "0.2.0",
  "type": "module",
  "description": "Getchyo groove on",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bassline-Org/bassline.git"
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint packages/*/src/**/*.js",
    "lint:fix": "eslint packages/*/src/**/*.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.11",
      "rollup": ">=4.59.0",
      "underscore": ">=1.13.8",
      "flatted": ">=3.4.0",
      "lodash": ">=4.17.23",
      "markdown-it": ">=14.1.1"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "msw"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@fast-check/vitest": "^0.3.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^61.7.1",
    "husky": "^9.1.7",
    "jsdoc": "^4.0.5",
    "knip": "^5.88.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2",
    "ws": "^8.20.0"
  }
}
